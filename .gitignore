# Shared ignore rules for this Flutter app and its platform projects.

# Local planning notes
/docs/puzzle-game-notes.md
/docs/puzzle-game-mvp-plan.md

# Operating system files
.DS_Store
._*
Thumbs.db

# Local editor state and temporary files
.idea/
*.iml
*.ipr
*.iws
.history/
*.swp
*.swo
*~
*.log
*.class
*.pyc
.atom/
.build/
.buildlog/
.svn/
.swiftpm/
migrate_working_dir/

# Keep shared .vscode launch configurations and tasks available to commit.

# Flutter, Dart, and Pub generated files
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
/build/
/coverage/
**/doc/api/
.widget_preview/
app.*.symbols
app.*.map.json

# Local dependency overrides; pubspec.lock belongs in version control.
pubspec_overrides.yaml

# Local environment settings; keep example files available to commit
.env
.env.*
!.env.example
!.env.*.example
!.env.sample
!.env.template

# App signing credentials and provisioning profiles
*.jks
*.keystore
*.p12
*.pfx
*.mobileprovision
*.provisionprofile

# Exported app packages and debug symbols
*.apk
*.aab
*.ipa
*.dSYM/

# Android build output and machine-specific configuration
/android/.gradle/
/android/.kotlin/
/android/build/
/android/app/build/
/android/app/debug/
/android/app/profile/
/android/app/release/
/android/captures/
/android/local.properties
/android/**/GeneratedPluginRegistrant.java
/android/**/.cxx/
/android/**/.externalNativeBuild/
/android/**/key.properties

# Gradle wrapper files generated by Flutter
/android/gradlew
/android/gradlew.bat
/android/**/gradle-wrapper.jar

# iOS dependencies, generated Flutter configuration, and build output
/ios/**/Pods/
/ios/**/.symlinks/
/ios/**/DerivedData/
/ios/**/.generated/
/ios/Flutter/.last_build_id
/ios/Flutter/App.framework
/ios/Flutter/Flutter.framework
/ios/Flutter/Flutter.podspec
/ios/Flutter/Generated.xcconfig
/ios/Flutter/ephemeral/
/ios/Flutter/app.flx
/ios/Flutter/app.zip
/ios/Flutter/flutter_assets/
/ios/Flutter/flutter_export_environment.sh
/ios/Runner/GeneratedPluginRegistrant.*
/ios/**/ServiceDefinitions.json

# Xcode user state and temporary files
/ios/**/xcuserdata/
/ios/**/*.mode1v3
/ios/**/*.mode2v3
/ios/**/*.moved-aside
/ios/**/*.pbxuser
/ios/**/*.perspectivev3
/ios/**/*sync/
/ios/**/dgph
/ios/**/.sconsign.dblite
/ios/**/.tags*
/ios/**/.vagrant/
/ios/**/Icon?
/ios/**/profile

# Shared Xcode defaults remain available to commit.
!/ios/**/default.mode1v3
!/ios/**/default.mode2v3
!/ios/**/default.pbxuser
!/ios/**/default.perspectivev3

# Local backups of pre-compression puzzle images
originals/
